{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "L'île des Cobayes",
  "version": "0.1.0",
  "identifier": "fr.bowsy.idc-launcher",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "L'île des Cobayes",
        "width": 480,
        "height": 760,
        "minWidth": 480,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
